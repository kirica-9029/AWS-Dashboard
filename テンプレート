AWSTemplateFormatVersion: '2010-09-09'
Description: Security monthly report CloudWatch Dashboard

Parameters:
  EnvironmentName:
    Type: String
    Default: prod
    Description: Environment name. Example prod, stg, dev

  DashboardName:
    Type: String
    Default: security-monthly-report-dashboard

  VpcFlowLogGroupName:
    Type: String
    Description: CloudWatch Logs log group name for VPC Flow Logs

  CloudTrailLogGroupName:
    Type: String
    Description: CloudWatch Logs log group name for CloudTrail logs

  GuardDutyLogGroupName:
    Type: String
    Default: ''
    Description: CloudWatch Logs log group name for GuardDuty findings. Leave blank if unused.

  SecurityHubLogGroupName:
    Type: String
    Default: ''
    Description: CloudWatch Logs log group name for Security Hub findings. Leave blank if unused.

Resources:
  SecurityMonthlyReportDashboard:
    Type: AWS::CloudWatch::Dashboard
    Properties:
      DashboardName: !Sub '${DashboardName}-${EnvironmentName}'
      DashboardBody: !Sub |
        {
          "start": "-P30D",
          "periodOverride": "inherit",
          "widgets": [
            {
              "type": "text",
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 1,
              "properties": {
                "markdown": "# Security Monthly Report Dashboard - ${EnvironmentName}"
              }
            },
            {
              "type": "log",
              "x": 12,
              "y": 7,
              "width": 12,
              "height": 6,
              "properties": {
                "region": "${AWS::Region}",
                "title": "VPC Flow Logs - 宛先ポート別不正アクセス試行（TCP）",
                "view": "table",
                "query": "SOURCE '${VpcFlowLogGroupName}'\n| fields @timestamp, @message\n| parse @message '* * * * * * * * * * * * * *' as version, account_id, interface_id, srcaddr, dstaddr, srcport, dstport, protocol, packets, bytes, start, end, action, log_status\n| filter not isIpInSubnet(srcaddr, '10.0.0.0/8')\n    and not isIpInSubnet(srcaddr, '172.16.0.0/12')\n    and not isIpInSubnet(srcaddr, '192.168.0.0/16')\n    and (isIpInSubnet(dstaddr, '10.0.0.0/8') or isIpInSubnet(dstaddr, '172.16.0.0/12') or isIpInSubnet(dstaddr, '192.168.0.0/16'))\n    and dstport in [20, 21, 22, 23, 25, 53, 80, 443, 445, 1433, 1521, 2049, 3306, 3389, 6379, 9200]\n    and protocol = 6\n| stats count(*) as attempts, sum(if(action='ACCEPT', 1, 0)) as accepted, sum(if(action='REJECT', 1, 0)) as rejected, count_distinct(srcaddr) as uniq_src, sum(packets) as packets_total, sum(bytes) as bytes_total by dstport, protocol\n| sort attempts desc\n| display dstport, protocol, attempts, accepted, rejected, uniq_src, (accepted*100.0/attempts) as accept_rate_pct, (bytes_total/attempts) as bytes_per_attempt"
              }
            },
            {
              "type": "log",
              "x": 0,
              "y": 13,
              "width": 12,
              "height": 6,
              "properties": {
                "region": "${AWS::Region}",
                "title": "VPC Flow Logs - 宛先ポート別不正アクセス試行（UDP）",
                "view": "table",
                "query": "SOURCE '${VpcFlowLogGroupName}'\n| fields @timestamp, @message\n| parse @message '* * * * * * * * * * * * * *' as version, account_id, interface_id, srcaddr, dstaddr, srcport, dstport, protocol, packets, bytes, start, end, action, log_status\n| filter not isIpInSubnet(srcaddr, '10.0.0.0/8')\n    and not isIpInSubnet(srcaddr, '172.16.0.0/12')\n    and not isIpInSubnet(srcaddr, '192.168.0.0/16')\n    and (isIpInSubnet(dstaddr, '10.0.0.0/8') or isIpInSubnet(dstaddr, '172.16.0.0/12') or isIpInSubnet(dstaddr, '192.168.0.0/16'))\n    and dstport in [20, 21, 22, 23, 25, 53, 80, 443, 445, 1433, 1521, 2049, 3306, 3389, 6379, 9200]\n    and protocol = 17\n| stats count(*) as attempts, sum(if(action='ACCEPT', 1, 0)) as accepted, sum(if(action='REJECT', 1, 0)) as rejected, count_distinct(srcaddr) as uniq_src, sum(packets) as packets_total, sum(bytes) as bytes_total by dstport, protocol\n| sort attempts desc\n| display dstport, protocol, attempts, accepted, rejected, uniq_src, (accepted*100.0/attempts) as accept_rate_pct, (bytes_total/attempts) as bytes_per_attempt"
              }
            },
            {
              "type": "log",
              "x": 12,
              "y": 13,
              "width": 12,
              "height": 6,
              "properties": {
                "region": "${AWS::Region}",
                "title": "CloudTrail - ログイン失敗回数が多いユーザー",
                "view": "table",
                "query": "SOURCE '${CloudTrailLogGroupName}'\n| filter eventSource='signin.amazonaws.com' and eventName='ConsoleLogin'\n| filter responseElements.ConsoleLogin='Failure' or ispresent(errorMessage)\n| stats count(*) as failed, count_distinct(sourceIPAddress) as src_ips, min(@timestamp) as firstTs, max(@timestamp) as lastTs by sourceIPAddress, userIdentity.type, userIdentity.userName\n| filter failed >= 5\n| sort failed desc"
              }
            },
            {
              "type": "log",
              "x": 0,
              "y": 19,
              "width": 12,
              "height": 6,
              "properties": {
                "region": "${AWS::Region}",
                "title": "CloudTrail - 許可外IPからのログイン成功",
                "view": "table",
                "query": "SOURCE '${CloudTrailLogGroupName}'\n| fields coalesce(userIdentity.userName, additionalEventData.userName) as user_display, additionalEventData.MFAUsed as mfa, sourceIPAddress as src_ip\n| filter eventSource='signin.amazonaws.com' and eventName='ConsoleLogin'\n| filter responseElements.ConsoleLogin='Success'\n| filter not (\n    isIpInSubnet(src_ip, '202.19.227.74/32')\n    or isIpInSubnet(src_ip, '202.19.228.74/32')\n    or isIpInSubnet(src_ip, '210.148.141.0/27')\n    or isIpInSubnet(src_ip, '210.148.200.0/27')\n    or isIpInSubnet(src_ip, '114.160.196.245/32')\n    or isIpInSubnet(src_ip, '114.160.237.193/32')\n    or isIpInSubnet(src_ip, '147.161.198.0/23')\n    or isIpInSubnet(src_ip, '167.103.28.0/23')\n    or isIpInSubnet(src_ip, '136.226.238.0/23')\n    or isIpInSubnet(src_ip, '167.103.42.0/23')\n    or isIpInSubnet(src_ip, '165.225.110.0/23')\n    or isIpInSubnet(src_ip, '165.225.96.0/23')\n    or isIpInSubnet(src_ip, '167.103.12.0/23')\n    or isIpInSubnet(src_ip, '167.103.14.0/23')\n    or isIpInSubnet(src_ip, '167.103.16.0/23')\n    or isIpInSubnet(src_ip, '167.103.8.0/23')\n    or isIpInSubnet(src_ip, '167.103.10.0/23')\n    or isIpInSubnet(src_ip, '147.161.194.0/23')\n    or isIpInSubnet(src_ip, '147.161.196.0/23')\n    or isIpInSubnet(src_ip, '167.103.44.0/23')\n    or isIpInSubnet(src_ip, '167.103.46.0/23')\n    or isIpInSubnet(src_ip, '147.161.192.0/23')\n    or isIpInSubnet(src_ip, '57.182.55.38/32')\n    or isIpInSubnet(src_ip, '208.127.118.0/23')\n    or isIpInSubnet(src_ip, '208.127.120.0/23')\n    or isIpInSubnet(src_ip, '210.162.30.96/28')\n    or isIpInSubnet(src_ip, '210.170.118.224/28')\n    or isIpInSubnet(src_ip, '218.44.52.224/28')\n    or isIpInSubnet(src_ip, '126.249.15.234/32')\n    or isIpInSubnet(src_ip, '122.26.25.2/32')\n    or isIpInSubnet(src_ip, '153.243.5.144/32')\n    or isIpInSubnet(src_ip, '34.85.34.13/32')\n    or isIpInSubnet(src_ip, '35.200.117.250/32')\n  )\n| stats count(*) as success, min(@timestamp) as firstTs, max(@timestamp) as lastTs by src_ip, user_display, mfa\n| sort success desc, lastTs desc"
              }
            },
            {
              "type": "log",
              "x": 12,
              "y": 19,
              "width": 12,
              "height": 6,
              "properties": {
                "region": "${AWS::Region}",
                "title": "GuardDuty - 検出結果一覧",
                "view": "table",
                "query": "SOURCE '${GuardDutyLogGroupName}'\n| fields @timestamp, detail.type, detail.severity, detail.title, detail.region\n| stats count(*) as finding_count by detail.type, detail.severity\n| sort finding_count desc"
              }
            },
            {
              "type": "log",
              "x": 0,
              "y": 25,
              "width": 12,
              "height": 6,
              "properties": {
                "region": "${AWS::Region}",
                "title": "SecurityHub - CCoE指定コントロール件数",
                "view": "table",
                "query": "SOURCE '${SecurityHubLogGroupName}'\n| fields @timestamp, detail.findings.0.Compliance.SecurityControlId, detail.findings.0.Compliance.Status, detail.findings.0.Workflow.Status, detail.findings.0.RecordState\n| filter detail.findings.0.Compliance.SecurityControlId in ['EC2.18', 'EC2.19', 'IAM.1', 'IAM.4', 'IAM.5', 'IAM.8', 'IAM.9', 'IAM.11', 'IAM.12', 'IAM.13', 'IAM.14', 'S3.2', 'S3.3']\n| filter detail.findings.0.RecordState='ACTIVE'\n| stats count(*) as finding_count by detail.findings.0.Compliance.SecurityControlId, detail.findings.0.Compliance.Status\n| sort finding_count desc"
              }
            },
            {
              "type": "metric",
              "x": 12,
              "y": 25,
              "width": 12,
              "height": 6,
              "properties": {
                "region": "${AWS::Region}",
                "title": "Shield Advanced - DDoS攻撃検出状況",
                "view": "timeSeries",
                "stacked": false,
                "metrics": [
                  ["AWS/DDoSProtection", "DDoSDetected"]
                ],
                "period": 300,
                "stat": "Maximum"
              }
            }
          ]
        }

Outputs:
  DashboardName:
    Description: Created CloudWatch Dashboard name
    Value: !Ref SecurityMonthlyReportDashboard
